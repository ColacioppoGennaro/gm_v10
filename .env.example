# Environment Configuration

APP_URI=https://gruppogea.net/gm_v10

# Database Configuration
DB_HOST=127.0.0.1
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# Authentication
ADMIN_TOKEN=gmv3_admin_2025
JWT_SECRET_KEY=jwt_secret_gm_v4_2025_random_key

# AI Services
GEMINI_API_KEY=your_gemini_api_key
DOCANALYZER_API_KEY=sk-da-api-xxxxx

# Google Calendar OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret
GOOGLE_REDIRECT_URI=https://gruppogea.net/gm_v10/api/auth/google/callback

# Push Notifications
PWA_PUSH=true
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
PUSH_SUBJECT=mailto:admin@gruppogea.net

# Email Configuration
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=notifiche@gruppogea.net
MAIL_FROM_NAME="GM v10"

# Stripe Payment (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png

# Rate Limiting
RATE_LIMIT_ENABLED=true
FREE_PLAN_AI_QUERIES_DAILY=20
FREE_PLAN_DOCUMENTS_DAILY=20

# Server Configuration (Backend)
PORT=5000
NODE_ENV=production
